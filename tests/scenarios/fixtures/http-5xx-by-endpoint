#!/bin/sh
# toolsmith-v1: Count 5xx responses per endpoint in nginx/combined access logs, numeric IDs and query strings folded; use for log trawling.
usage() {
    cat <<'USAGE'
usage: http-5xx-by-endpoint [FILE...]

Counts 5xx responses per endpoint in nginx access logs (combined or common
format), reading FILEs or stdin. Query strings are dropped and numeric path
segments become :id, so /api/users/123 and /api/users/456 count together.
Prints "COUNT ENDPOINT" lines, highest count first.

Use it for a quick breakdown of which endpoints are failing.
USAGE
}
case ${1-} in -h|--help) usage; exit 0 ;; esac
awk '$9 ~ /^5[0-9][0-9]$/ {
    p = $7; sub(/\?.*/, "", p)
    n = split(p, s, "/"); out = ""
    for (i = 2; i <= n; i++) out = out "/" (s[i] ~ /^[0-9]+$/ ? ":id" : s[i])
    if (out == "") out = "/"
    c[out]++
} END { for (k in c) printf "%d %s\n", c[k], k }' "$@" | sort -k1,1nr -k2
