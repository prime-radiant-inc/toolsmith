#!/usr/bin/env bash
# toolsmith-repo: deterministic plumbing for the toolsmith tools repo.
# Must run under macOS's /bin/bash 3.2. See usage below.

# TOOLSMITH_TEST_REPO is for tests only: the pressure scenarios run real
# sessions with the real login and must not touch the real tools repo.
TOOLS_REPO_DEFAULT="${TOOLSMITH_TEST_REPO:-$HOME/.local/share/toolsmith/tools}"
CATALOG_HEADER='# Tools catalog. Generated by toolsmith-repo; do not edit.'

usage() {
    cat <<'EOF'
usage: toolsmith-repo <subcommand> [args]

Owns all plumbing for the toolsmith tools repo at
~/.local/share/toolsmith/tools (symlink it to keep it elsewhere): finding it and
creating it on first run. The toolsmith agent and the
plugin's hooks call this instead of running git themselves, so the
fiddly parts have one tested implementation.

Subcommands:
  toolsmith-repo path [--project <dir>]
                           Print the canonical tools repo path, creating and
                           initialising the repo first if needed. Use this
                           before reading the catalog or writing a tool.
  toolsmith-repo locate [--project <dir>]
                           Print the same paths as `path` without creating or
                           changing anything, even when the repo does not
                           exist yet. Use this from hooks.
  toolsmith-repo catalog [--project <dir>]
                           Rewrite the scope's CATALOG.md from the
                           toolsmith-v1: headers of the tools in its bin/.
                           Does not commit. Creates the repo first if needed.
  toolsmith-repo stage <name> [--project <dir>]
                           Copy the scope's bin/<name>, if it exists, into a
                           fresh dir under $TMPDIR/toolsmith-<uid>/stage/ and
                           print its path and base revision. Edit and test
                           the staged copy, then install it.
  toolsmith-repo install <staged-file> <name> --base <rev> -m <message>
                         [--project <dir>]
                           Under the repo lock: check bin/<name> is still at
                           <rev>, copy the staged file in as an executable,
                           rewrite the scope's catalog, and commit the tool,
                           the catalog, the project's PROJECT file, and any
                           other uncommitted files in the scope's bin/.
  toolsmith-repo move <name> --project <dir> --to global|project
                           Under the repo lock: move the committed tool
                           <name> from the project's bin/ to the global bin/
                           (--to global) or the reverse (--to project),
                           rewrite both catalogs, and commit the move, both
                           catalogs, the project's PROJECT file, and any other
                           uncommitted files in either scope's bin/ in one
                           commit.

<name> is lowercase letters, digits, '.', '_' and '-', starting with a
letter or digit. --project <dir> works on the project scope for the git repo
containing <dir>. Every subdirectory and worktree of one repo shares a
project key. Only install and move create the project's directory.

catalog and install accept --lock-tries <n> (default 100, 0.1s apart), for
tests that need a lock timeout to happen quickly.

TOOLSMITH_TEST_REPO=<dir>, when set and non-empty, replaces
~/.local/share/toolsmith/tools as the tools repo path for every subcommand.
It is for tests only, so pressure scenarios can run without touching the
real tools repo.

Output is key=value lines on stdout:
  repo=<canonical repo path>
  global_catalog=<repo>/CATALOG.md
  note=<something worth telling the user>   (repeatable)
  project_key=<basename of project root>-<6 hex>      (--project only)
  project_dir=<repo>/projects/<key>                   (--project only)
  project_catalog=<repo>/projects/<key>/CATALOG.md    (--project only)
catalog prints only note= lines and:
  untracked=<abs path>   (repeatable; a bin/ file that differs from HEAD)
stage prints note= lines and:
  staged=<abs path of the staged copy>
  base=<git blob hash of the copy, or "absent" for a new tool>
install prints note= lines and:
  catalog=<the tool's catalog line>
  commit=<HEAD after the install>
  adopted=<abs path>     (repeatable; another bin/ file committed with it)
move prints note= lines and:
  catalog=<the tool's catalog line at its new location>
  commit=<HEAD after the move>
  adopted=<abs path>     (repeatable; another bin/ file committed with it)

Errors go to stderr. Exit codes:
  0 ok, 1 usage error, bad tool name, or no such tool to move,
  2 operation failed (filesystem or git error),
  3 bin/<name> changed since it was staged (stage again and redo the edit),
  4 timed out waiting for the repo lock,
  5 the tools repo is mid-rebase or mid-merge,
  6 git is missing or not working,
  7 the staged file has no toolsmith-v1: header in its first five lines,
  8 --project dir is not inside a git repo (repo= and global_catalog= are
    still printed first, so callers can fall back to the global scope),
  9 the move destination already exists.
EOF
}

die() {
    local code=$1
    shift
    printf 'toolsmith-repo: %s\n' "$*" >&2
    exit "$code"
}

usage_error() {
    printf 'toolsmith-repo: %s. Run toolsmith-repo --help for usage.\n' "$1" >&2
    exit 1
}

# git counts as missing when it isn't on PATH, or when it's there but
# `git --version` fails, which is how the macOS Command Line Tools stub
# behaves before the tools are installed.
require_git() {
    if ! command -v git >/dev/null 2>&1 || ! git --version >/dev/null 2>&1; then
        die 6 "git is not installed or not working. Install git (on macOS: xcode-select --install) and try again."
    fi
}

# Print the directory the tools repo lives in, or would live in, before
# canonicalisation. If the default path is a symlink, follow it, resolving
# each relative target against the symlink's own directory (readlink returns
# relative targets as written, and the cwd is irrelevant).
tools_repo_target() {
    local path=$TOOLS_REPO_DEFAULT link hops=0
    while [ -L "$path" ] && [ "$hops" -lt 40 ]; do
        link=$(readlink "$path")
        case $link in
            /*) path=$link ;;
            *) path="${path%/*}/$link" ;;
        esac
        hops=$((hops + 1))
    done
    printf '%s\n' "$path"
}

# Print the canonical form of a path that may not exist yet, without creating
# anything: canonicalise the deepest existing ancestor and append the rest.
canonical_path() {
    local path=$1 parent base
    if [ -d "$path" ]; then
        (cd -P -- "$path" && pwd -P)
        return
    fi
    parent=${path%/*}
    base=${path##*/}
    [ -n "$parent" ] || parent=/
    parent=$(canonical_path "$parent") || return 1
    case $base in
        ''|.) printf '%s\n' "$parent" ;;
        ..) parent=${parent%/*}; printf '%s\n' "${parent:-/}" ;;
        *) printf '%s/%s\n' "${parent%/}" "$base" ;;
    esac
}

print_paths() {
    printf 'repo=%s\n' "$1"
    printf 'global_catalog=%s/CATALOG.md\n' "$1"
}

# Print the canonical tools repo path, or the path it would have, without
# creating anything.
locate_repo() {
    canonical_path "$(tools_repo_target)" ||
        die 2 "could not work out where the tools repo is. Check $TOOLS_REPO_DEFAULT."
}

# project_root <dir>: print the canonical root of the git repo containing
# a directory. The root comes from the common git dir rather than the
# toplevel, so every worktree and subdirectory of one repo shares a root.
project_root() {
    local dir=$1 common root
    require_git
    common=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) ||
        die 8 "$dir is not inside a git repository. Use the global scope (leave out --project) instead."
    case $common in
        */.git) root=${common%/.git}; [ -n "$root" ] || root=/ ;;
        *) root=$common ;;
    esac
    (cd -P -- "$root" && pwd -P) || die 2 "could not enter project root $root. Check its permissions."
}

# project_key <root>: print the project key for a project root: its
# basename plus 6 hex chars of a hash of its canonical path.
project_key() {
    local root=$1 hash
    hash=$(printf %s "$root" | git hash-object --stdin) ||
        die 2 "could not hash the project root $root. Check that git is working."
    printf '%s-%s\n' "${root##*/}" "${hash:0:6}"
}

# resolve_scope [<project-dir>]: set SCOPE_DIR to the directory holding a
# scope's bin/ and CATALOG.md (the tools repo for the global scope, or
# <repo>/projects/<key>), SCOPE_KEY to the project key and SCOPE_ROOT to the
# project root (both empty for the global scope). An empty or absent
# <project-dir> means the global scope; it must never reach `git -C ""`,
# which would use the cwd's repo. Creates nothing. Exits 8 if <project-dir>
# is not in a git repo.
resolve_scope() {
    SCOPE_DIR=$(locate_repo) || exit $?
    SCOPE_KEY=''
    SCOPE_ROOT=''
    [ -n "${1-}" ] || return 0
    SCOPE_ROOT=$(project_root "$1") || exit $?
    SCOPE_KEY=$(project_key "$SCOPE_ROOT") || exit $?
    SCOPE_DIR="$SCOPE_DIR/projects/$SCOPE_KEY"
}

# print_project_paths <project-dir>: print the project_* keys, or nothing
# when <project-dir> is empty (global scope).
print_project_paths() {
    resolve_scope "$1"
    [ -n "$SCOPE_KEY" ] || return 0
    printf 'project_key=%s\n' "$SCOPE_KEY"
    printf 'project_dir=%s\n' "$SCOPE_DIR"
    printf 'project_catalog=%s/CATALOG.md\n' "$SCOPE_DIR"
}

# parse_scope_args <subcommand> [args]: accept an optional --project <dir>,
# setting PROJECT_ARG (empty when absent), and for catalog, which takes the
# lock, the test-only --lock-tries <n>.
parse_scope_args() {
    local subcommand=$1
    shift
    PROJECT_ARG=''
    while [ "$#" -gt 0 ]; do
        case $1 in
            --project)
                [ -n "${2-}" ] || usage_error "--project needs a directory"
                PROJECT_ARG=$2
                shift 2
                ;;
            --lock-tries)
                [ "$subcommand" = catalog ] || usage_error "unknown argument to $subcommand: $1"
                set_lock_tries "${2-}"
                shift 2
                ;;
            *) usage_error "unknown argument to $subcommand: $1" ;;
        esac
    done
}

write_readme() {
    cat >"$1/README.md" <<'EOF'
# Tools

Command-line tools built by the toolsmith Claude Code agent. Tools live in
`bin/`, and `CATALOG.md` lists each one with its purpose.

`toolsmith-repo` manages this repo: it regenerates the catalog and makes the
commits, so change tools through the toolsmith rather than by hand.
EOF
}

# A directory counts as the tools repo once it has its own .git with a
# commit. Checking .git first stops a parent repo's HEAD from counting.
repo_is_initialised() {
    [ -e "$1/.git" ] && git -C "$1" rev-parse -q --verify HEAD >/dev/null
}

# ensure_identity <repo>: if git has no identity to commit with, set a
# repo-local one and append a note= line to NOTES. Runs at init and before
# every install commit, since the user's config can change after init.
ensure_identity() {
    local repo=$1
    if [ -z "$(git -C "$repo" config user.name)" ] || [ -z "$(git -C "$repo" config user.email)" ]; then
        git -C "$repo" config user.name toolsmith &&
            git -C "$repo" config user.email toolsmith@localhost ||
            die 2 "could not set a git identity in $repo. Check that $repo/.git/config is writable."
        NOTES="${NOTES}note=no git identity configured, so set a repo-local git identity (toolsmith <toolsmith@localhost>) in $repo
"
    fi
}

# Turn a directory into the tools repo: git init (unless an earlier run got
# that far), a repo-local identity if none is configured, README and
# catalog, and a first commit of everything in it. Appends to the NOTES
# variable.
init_repo() {
    local repo=$1
    if [ ! -e "$repo/.git" ]; then
        git -C "$repo" init -q || die 2 "git init failed in $repo. Check the directory is writable."
    fi
    ensure_identity "$repo"
    [ -e "$repo/README.md" ] || write_readme "$repo"
    [ -e "$repo/CATALOG.md" ] || printf '%s\n' "$CATALOG_HEADER" >"$repo/CATALOG.md"
    git -C "$repo" add -A &&
        git -C "$repo" commit -q -m "Initialise toolsmith tools repo" ||
        die 2 "first commit failed in $repo. Check your git commit signing or hooks config, then run toolsmith-repo path again."
}

# ensure_repo: find the tools repo, creating and initialising it first if
# needed. Sets REPO to its canonical path and NOTES to any note= lines.
ensure_repo() {
    require_git

    local target created=no
    NOTES=''
    mkdir -p "${TOOLS_REPO_DEFAULT%/*}" ||
        die 2 "could not create ${TOOLS_REPO_DEFAULT%/*}. Check that it is writable."
    target=$(tools_repo_target)
    if [ ! -d "$target" ]; then
        mkdir -p "$target" || die 2 "could not create the tools repo at $target. Check the path and its permissions."
        created=yes
    fi
    REPO=$(cd -P -- "$target" && pwd -P) || die 2 "could not enter $target. Check its permissions."

    if ! repo_is_initialised "$REPO"; then
        if [ "$created" = yes ]; then
            NOTES="note=created tools repo at $REPO
"
        elif [ -e "$REPO/.git" ]; then
            NOTES="note=created tools repo at $REPO, finishing an earlier run's incomplete setup
"
        else
            NOTES="note=initialised existing directory $REPO as the tools repo
"
        fi
        init_repo "$REPO"
    fi
}

cmd_path() {
    parse_scope_args path "$@"
    ensure_repo
    print_paths "$REPO"
    printf '%s' "$NOTES"
    print_project_paths "$PROJECT_ARG"
}

# header_purpose <file>: print the purpose from a toolsmith-v1: header in
# the file's first five lines, or nothing if there is none. Only the first
# five lines count, so a header quoted in help text further down is ignored.
# sed runs in the C locale so bytes that are not valid in the user's locale
# (Latin-1 text, binaries) match as plain bytes instead of erroring.
header_purpose() {
    head -n 5 -- "$1" 2>/dev/null |
        LC_ALL=C sed -n -E 's,^[[:space:]]*(#|//|--)[[:space:]]*toolsmith-v1:[[:space:]]*(.*[^[:space:]])[[:space:]]*$,\2,p' |
        head -n 1
}

# write_catalog <scope_dir>: rewrite <scope_dir>/CATALOG.md from the tools
# in <scope_dir>/bin, one line per tool sorted by path in the C locale. The
# new catalog is written beside the old one and renamed over it, so readers
# never see a half-written file.
write_catalog() {
    local scope=$1 tool tmp="$1/CATALOG.md.tmp"
    {
        printf '%s\n' "$CATALOG_HEADER"
        for tool in "$scope"/bin/*; do
            [ -f "$tool" ] || continue
            catalog_line "$tool" "$(header_purpose "$tool")"
        done | LC_ALL=C sort
    } >"$tmp" && mv -f -- "$tmp" "$scope/CATALOG.md" ||
        die 2 "could not write $scope/CATALOG.md. Check the directory is writable."
}

# catalog_line <tool path> <purpose>: print the tool's catalog line.
catalog_line() {
    printf -- '- %s -- %s\n' "$1" "${2:-(no toolsmith-v1 header)}"
}

# uncommitted_bin_files <repo> <scope_dir>: print the repo-relative path of
# each file in <scope_dir>/bin that differs from HEAD (untracked, staged,
# modified or deleted), one per line. -z keeps porcelain paths unquoted; a
# rename's second field (its old path) is skipped. pipefail (in a subshell,
# to keep it local) makes a git failure fail the function.
# Untracked files the user's ignore rules match (a global `bin/` ignore) are
# listed too (--ignored=traditional with -uall names each one; "matching"
# would name only the bin/ dir), so the files adopted are the files
# write_catalog lists. Like write_catalog's bin/* glob, ignored dotfiles
# such as .DS_Store are skipped.
uncommitted_bin_files() {
    local repo=$1 entry
    (
        set -o pipefail
        git -C "$repo" status --porcelain -z --untracked-files=all --ignored=traditional -- "$2/bin" |
            while IFS= read -r -d '' entry; do
                case $entry in
                    '!! '*) case ${entry##*/} in .*) continue ;; esac ;;
                esac
                printf '%s\n' "${entry:3}"
                case $entry in
                    R*|C*) IFS= read -r -d '' entry ;;
                esac
            done
    ) || die 2 "git status failed in $repo. Check the repo with git status."
}

# print_uncommitted <repo> <scope_dir>: print untracked=<abs path> for each
# file in <scope_dir>/bin that differs from HEAD.
print_uncommitted() {
    local files file
    files=$(uncommitted_bin_files "$1" "$2") || exit $?
    [ -n "$files" ] || return 0
    while IFS= read -r file; do
        printf 'untracked=%s/%s\n' "$1" "$file"
    done <<EOF
$files
EOF
}

# The install lock is a directory in the tools repo's git dir, holding the
# holder's PID. mkdir is atomic, so exactly one process creates it. Every
# write to the tools repo (files, index, commits) happens while holding it.
# LOCK_TRIES is how many times to try before giving up, 0.1s apart.
LOCK_TRIES=100
LOCK_DIR=''
# Scratch files install and move keep in the lock dir: install's temp copy
# of the tool, and the snapshots a failed write rolls back from (the index,
# plus prev-<n> for each saved file, removed by glob).
LOCK_FILES='pid tool index'

# acquire_lock: take the lock for $REPO, breaking it if its holder has died.
# Sets LOCK_DIR and arranges for the lock to be released on exit. Exits 4
# if the lock is still held after LOCK_TRIES tries.
acquire_lock() {
    local git_dir lock holder tries=0
    git_dir=$(git -C "$REPO" rev-parse --absolute-git-dir) ||
        die 2 "could not find the git dir of $REPO. Check the repo with git status."
    lock="$git_dir/toolsmith.lock"
    until mkdir -- "$lock" 2>/dev/null; do
        holder=$(cat -- "$lock/pid" 2>/dev/null)
        if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null && break_stale_lock "$lock" "$holder"; then
            continue
        fi
        tries=$((tries + 1))
        [ "$tries" -lt "$LOCK_TRIES" ] ||
            die 4 "timed out waiting for the lock $lock (held by PID ${holder:-unknown}). Retry; if no toolsmith-repo is running, remove that directory and retry."
        sleep 0.1
    done
    LOCK_DIR=$lock
    trap release_lock EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    printf '%s\n' "$$" >"$LOCK_DIR/pid" || die 2 "could not write $LOCK_DIR/pid. Check that $git_dir is writable."
}

# break_stale_lock <lock> <dead pid>: remove a lock whose holder has died.
# Two waiters can both see the same dead PID; without the .break guard, the
# slower one could remove the lock the faster one has just taken. Under the
# guard, the PID is re-read and the lock removed only if it is unchanged.
# A lock that is just being taken has no PID yet, so it is never removed.
# Returns 0 if it removed the lock.
break_stale_lock() {
    local lock=$1 dead=$2 guard="$1.break" removed=1
    mkdir -- "$guard" 2>/dev/null || return 1
    if [ "$(cat -- "$lock/pid" 2>/dev/null)" = "$dead" ]; then
        remove_lock_dir "$lock" && removed=0
    fi
    rmdir -- "$guard"
    return "$removed"
}

# remove_lock_dir <lock>: remove a lock dir and the scratch files in it.
remove_lock_dir() {
    local file
    for file in $LOCK_FILES; do
        rm -f -- "$1/$file"
    done
    rm -f -- "$1"/prev-*
    rmdir -- "$1" 2>/dev/null
}

# release_lock: roll back an unfinished install or move, then remove the
# lock if this process holds it. This is the EXIT trap while the lock is held.
release_lock() {
    [ -n "$LOCK_DIR" ] || return 0
    rollback_writes
    remove_lock_dir "$LOCK_DIR"
    LOCK_DIR=''
}

# with_lock <cmd...>: run a command holding the tools repo lock. The command
# may exit; the EXIT trap releases the lock either way.
with_lock() {
    local status
    acquire_lock
    "$@"
    status=$?
    release_lock
    trap - EXIT HUP INT TERM
    return "$status"
}

# set_lock_tries <n>: the test-only --lock-tries option.
set_lock_tries() {
    case $1 in
        ''|*[!0-9]*|0) usage_error "--lock-tries needs a positive whole number" ;;
    esac
    LOCK_TRIES=$1
}

# check_name <name>: exit 1 unless <name> is a valid tool name. Letters are
# spelled out because a-z ranges can match capitals in some locales.
check_name() {
    local lower=abcdefghijklmnopqrstuvwxyz digits=0123456789
    case $1 in
        ''|[!$lower$digits]*|*[!$lower$digits._-]*)
            usage_error "invalid tool name '$1': use lowercase letters, digits, '.', '_' and '-', starting with a letter or digit"
            ;;
    esac
}

# blob_or_absent <file>: print the git blob hash of a file's raw bytes, or
# "absent". Run in the tools repo with --no-filters so the caller's repo
# (autocrlf, attributes) cannot change the hash between stage and install.
blob_or_absent() {
    if [ -e "$1" ] || [ -L "$1" ]; then
        git -C "$REPO" hash-object --no-filters -- "$1" || die 2 "could not hash $1. Check that it is a readable file."
    else
        printf 'absent\n'
    fi
}

cmd_catalog() {
    parse_scope_args catalog "$@"
    ensure_repo
    printf '%s' "$NOTES"
    resolve_scope "$PROJECT_ARG"
    if [ ! -d "$SCOPE_DIR" ]; then
        printf 'note=project %s has no tools yet, so there is no catalog to write\n' "$SCOPE_KEY"
        return 0
    fi
    with_lock catalog_locked
}

catalog_locked() {
    write_catalog "$SCOPE_DIR"
    print_uncommitted "$REPO" "$SCOPE_DIR"
}

# stage hashes the staged copy rather than the tool, so the base always
# describes exactly the content handed out, even if the tool changes
# between the copy and the hash.
cmd_stage() {
    [ "$#" -gt 0 ] || usage_error "stage needs a tool name"
    local name=$1 root dir staged base
    shift
    check_name "$name"
    parse_scope_args stage "$@"
    ensure_repo
    printf '%s' "$NOTES"
    resolve_scope "$PROJECT_ARG"
    root="${TMPDIR:-/tmp}"
    root="${root%/}/toolsmith-$(id -u)/stage"
    mkdir -p -- "$root" && dir=$(mktemp -d "$root/XXXXXX") ||
        die 2 "could not create a staging dir under $root. Check that it is writable."
    staged="$dir/$name"
    if [ -e "$SCOPE_DIR/bin/$name" ]; then
        cp -- "$SCOPE_DIR/bin/$name" "$staged" ||
            die 2 "could not copy $SCOPE_DIR/bin/$name to $staged. Check both are accessible."
    fi
    base=$(blob_or_absent "$staged") || exit $?
    printf 'staged=%s\n' "$staged"
    printf 'base=%s\n' "$base"
}

cmd_install() {
    local staged='' name='' base='' message=''
    PROJECT_ARG=''
    while [ "$#" -gt 0 ]; do
        case $1 in
            --base)
                [ -n "${2-}" ] || usage_error "--base needs a revision (the base= from stage)"
                base=$2
                shift 2
                ;;
            -m)
                [ -n "${2-}" ] || usage_error "-m needs a commit message"
                message=$2
                shift 2
                ;;
            --project)
                [ -n "${2-}" ] || usage_error "--project needs a directory"
                PROJECT_ARG=$2
                shift 2
                ;;
            --lock-tries)
                set_lock_tries "${2-}"
                shift 2
                ;;
            -*) usage_error "unknown argument to install: $1" ;;
            *)
                if [ -z "$staged" ]; then staged=$1
                elif [ -z "$name" ]; then name=$1
                else usage_error "unexpected argument to install: $1"
                fi
                shift
                ;;
        esac
    done
    [ -n "$staged" ] && [ -n "$name" ] || usage_error "install needs a staged file and a tool name"
    [ -n "$base" ] || usage_error "install needs --base <rev> (the base= from stage)"
    [ -n "$message" ] || usage_error "install needs -m <commit message>"
    check_name "$name"
    [ -f "$staged" ] && [ -r "$staged" ] ||
        die 2 "cannot read the staged file $staged. Check the path from stage, or stage again."
    ensure_repo
    printf '%s' "$NOTES"
    NOTES=''
    resolve_scope "$PROJECT_ARG"
    with_lock install_locked "$staged" "$name" "$base" "$message"
}

# A failed install or move must leave the tools repo as it found it:
# otherwise a retry of an install sees its own half-install as a moved base
# (exit 3), and the next install of any tool adopts the leftover file.
# snapshot_writes records what the command is about to change, in the lock
# dir; rollback_writes (run by release_lock on any exit while WRITE_PENDING
# is yes) puts it back. Restoring the saved index unstages exactly what the
# command staged, so files install would have adopted, and anything the
# user staged, end up as they were.
WRITE_PENDING=no
WRITE_WHAT=''
SAVED_FILES=()
NEW_DIRS=()

# note_new_dirs <dir>...: record which of these directories do not exist
# yet, so rollback removes them. List them deepest first.
note_new_dirs() {
    local dir
    for dir in "$@"; do
        [ -d "$dir" ] || NEW_DIRS+=("$dir")
    done
}

# snapshot_writes <what> <file>...: save the index and each file (one that
# does not exist yet is removed on rollback), and arm the rollback. <what>
# names the command for the rollback's error message, e.g. "install of x".
snapshot_writes() {
    local file n=0 git_dir=${LOCK_DIR%/*}
    WRITE_WHAT=$1
    shift
    SAVED_FILES=("$@")
    { [ ! -e "$git_dir/index" ] || cp -p -- "$git_dir/index" "$LOCK_DIR/index"; } ||
        die 2 "could not save the tools repo's index to $LOCK_DIR before the $WRITE_WHAT. Check that $git_dir is writable."
    for file in "$@"; do
        [ ! -e "$file" ] || cp -p -- "$file" "$LOCK_DIR/prev-$n" ||
            die 2 "could not save $file to $LOCK_DIR before the $WRITE_WHAT. Check that $git_dir is writable."
        n=$((n + 1))
    done
    WRITE_PENDING=yes
}

# restore_file <saved> <path>: put a saved copy back, or remove <path> if
# there was none (it did not exist before the write).
restore_file() {
    if [ -e "$1" ]; then
        mv -f -- "$1" "$2"
    else
        rm -f -- "$2"
    fi
}

rollback_writes() {
    [ "$WRITE_PENDING" = yes ] || return 0
    WRITE_PENDING=no
    local file dir n=0 failed=no git_dir=${LOCK_DIR%/*}
    if [ -e "$LOCK_DIR/index" ]; then
        mv -f -- "$LOCK_DIR/index" "$git_dir/index" || failed=yes
    fi
    for file in ${SAVED_FILES[@]+"${SAVED_FILES[@]}"}; do
        restore_file "$LOCK_DIR/prev-$n" "$file" || failed=yes
        case $file in
            */CATALOG.md) rm -f -- "$file.tmp" ;;
        esac
        n=$((n + 1))
    done
    for dir in ${NEW_DIRS[@]+"${NEW_DIRS[@]}"}; do
        [ ! -d "$dir" ] || rmdir -- "$dir" || failed=yes
    done
    if [ "$failed" = yes ]; then
        printf 'toolsmith-repo: could not fully roll back the failed %s. Check %s with git status and tidy it by hand.\n' "$WRITE_WHAT" "$REPO" >&2
    fi
}

# refuse_mid_rebase <subcommand>: exit 5 if the tools repo is mid-rebase or
# mid-merge.
refuse_mid_rebase() {
    local marker git_dir=${LOCK_DIR%/*}
    for marker in rebase-merge rebase-apply MERGE_HEAD; do
        [ ! -e "$git_dir/$marker" ] ||
            die 5 "the tools repo $REPO is mid-rebase or mid-merge ($git_dir/$marker exists). Finish or abort it with git, then $1 again."
    done
}

# scope_prefix <scope_dir>: print a scope's path relative to the repo, with
# a trailing slash, or nothing for the global scope.
scope_prefix() {
    local rel=${1#"$REPO"}
    rel=${rel#/}
    printf '%s' "${rel:+$rel/}"
}

# write_project_file: give the project scope (SCOPE_*) its PROJECT file,
# holding the project root, if it has none yet. Does nothing for global.
write_project_file() {
    [ -n "$SCOPE_KEY" ] && [ ! -e "$SCOPE_DIR/PROJECT" ] || return 0
    printf '%s\n' "$SCOPE_ROOT" >"$SCOPE_DIR/PROJECT" ||
        die 2 "could not write $SCOPE_DIR/PROJECT. Check that $SCOPE_DIR is writable."
}

# commit_paths <subcommand> <retry hint> <message> <path>...: stage and
# commit exactly these repo-relative paths, or add a note if none of them
# changed. Literal pathspecs, so tool names with glob characters match only
# themselves. -f adds them even when the user's ignore rules match them (a
# global `bin/` ignore is common); it forces only these explicit paths.
# `commit -- <paths>` commits only those paths, leaving anything else the
# user has staged where it is.
commit_paths() {
    local subcommand=$1 retry=$2 message=$3
    shift 3
    ensure_identity "$REPO"
    git --literal-pathspecs -C "$REPO" add -A -f -- "$@" ||
        die 2 "git add failed in $REPO. Check the repo with git status."
    if git --literal-pathspecs -C "$REPO" diff --cached --quiet HEAD -- "$@"; then
        NOTES="${NOTES}note=nothing changed, so there was nothing to commit
"
    else
        git --literal-pathspecs -C "$REPO" commit -q -m "$message" -- "$@" ||
            die 2 "git commit failed in $REPO (git's message is above), so the $subcommand was rolled back. Check your git commit signing or hooks config, then $retry."
    fi
    WRITE_PENDING=no
}

# adopt_uncommitted <scope_dir> <skip>: append every uncommitted file in
# <scope_dir>/bin (untracked, modified or deleted), except the repo-relative
# path <skip>, to the caller's paths array, and an adopted=<abs path> line
# for each to the caller's adopted string. Committing them keeps the
# committed catalog in step with the committed bin/. Callers declare paths
# and adopted as locals; bash's dynamic scoping makes them visible here.
adopt_uncommitted() {
    local files file
    files=$(uncommitted_bin_files "$REPO" "$1") || exit $?
    while IFS= read -r file; do
        [ -n "$file" ] && [ "$file" != "$2" ] || continue
        paths+=("$file")
        adopted="${adopted}adopted=$REPO/$file
"
    done <<EOF
$files
EOF
}

# install_locked <staged> <name> <base> <message>: the body of install, run
# holding the lock. Every check that can refuse comes before any write.
install_locked() {
    local staged=$1 name=$2 base=$3 message=$4 current purpose
    local tool="$SCOPE_DIR/bin/$name" scope_rel paths adopted=''
    refuse_mid_rebase install

    current=$(blob_or_absent "$tool") || exit $?
    [ "$current" = "$base" ] ||
        die 3 "bin/$name changed since it was staged (base $base, now $current). Re-stage it with toolsmith-repo stage $name, redo your edits on the new copy, and install again."

    purpose=$(header_purpose "$staged")
    [ -n "$purpose" ] ||
        die 7 "$staged has no toolsmith-v1: header in its first five lines. Add a line like '# toolsmith-v1: <purpose>' near the top, then install again."

    note_new_dirs "$SCOPE_DIR/bin" "$SCOPE_DIR" "$REPO/projects"
    if [ -n "$SCOPE_KEY" ]; then
        snapshot_writes "install of $name" "$tool" "$SCOPE_DIR/CATALOG.md" "$SCOPE_DIR/PROJECT"
    else
        snapshot_writes "install of $name" "$tool" "$SCOPE_DIR/CATALOG.md"
    fi
    mkdir -p -- "$SCOPE_DIR/bin" ||
        die 2 "could not create $SCOPE_DIR/bin. Check that $REPO is writable."
    # Copy beside the lock and rename into place, so nobody sees a half-copied tool.
    cp -- "$staged" "$LOCK_DIR/tool" && chmod +x "$LOCK_DIR/tool" && mv -f -- "$LOCK_DIR/tool" "$tool" ||
        die 2 "could not copy $staged to $tool. Check that both are accessible."
    write_project_file
    write_catalog "$SCOPE_DIR"

    # Repo-relative paths to commit: the tool, the catalog, PROJECT for a
    # project, and every other uncommitted file in the scope's bin/.
    scope_rel=$(scope_prefix "$SCOPE_DIR")
    paths=("${scope_rel}bin/$name" "${scope_rel}CATALOG.md")
    [ -z "$SCOPE_KEY" ] || paths+=("${scope_rel}PROJECT")
    adopt_uncommitted "$SCOPE_DIR" "${scope_rel}bin/$name"

    commit_paths install "install again with the same --base" "$message" "${paths[@]}"
    printf '%s' "$NOTES"
    printf 'catalog=%s\n' "$(catalog_line "$tool" "$purpose")"
    printf 'commit=%s\n' "$(git -C "$REPO" rev-parse HEAD)"
    printf '%s' "$adopted"
}

cmd_move() {
    local name='' to=''
    PROJECT_ARG=''
    while [ "$#" -gt 0 ]; do
        case $1 in
            --to)
                case ${2-} in
                    global|project) to=$2 ;;
                    *) usage_error "--to needs global or project" ;;
                esac
                shift 2
                ;;
            --project)
                [ -n "${2-}" ] || usage_error "--project needs a directory"
                PROJECT_ARG=$2
                shift 2
                ;;
            -*) usage_error "unknown argument to move: $1" ;;
            *)
                [ -z "$name" ] || usage_error "unexpected argument to move: $1"
                name=$1
                shift
                ;;
        esac
    done
    [ -n "$name" ] || usage_error "move needs a tool name"
    [ -n "$PROJECT_ARG" ] || usage_error "move needs --project <dir> (the project whose scope is one side of the move)"
    [ -n "$to" ] || usage_error "move needs --to global or --to project"
    check_name "$name"
    ensure_repo
    printf '%s' "$NOTES"
    NOTES=''
    resolve_scope "$PROJECT_ARG"
    with_lock move_locked "$name" "$to"
}

# move_locked <name> <to>: the body of move, run holding the lock. SCOPE_*
# is the project scope; the other side is the global scope, $REPO. Every
# check that can refuse comes before any write.
move_locked() {
    local name=$1 to=$2 from_dir to_dir from_desc message src dst src_rel dst_rel paths adopted=''
    if [ "$to" = global ]; then
        from_dir=$SCOPE_DIR to_dir=$REPO
        from_desc="project $SCOPE_KEY ($SCOPE_DIR/bin)"
        message="Move $name to global"
    else
        from_dir=$REPO to_dir=$SCOPE_DIR
        from_desc="global scope ($REPO/bin)"
        message="Move $name to project $SCOPE_KEY"
    fi
    src="$from_dir/bin/$name"
    dst="$to_dir/bin/$name"
    src_rel="$(scope_prefix "$from_dir")bin/$name"
    dst_rel="$(scope_prefix "$to_dir")bin/$name"
    refuse_mid_rebase move

    [ -f "$src" ] ||
        die 1 "no tool named $name in the $from_desc. Check the name and which scope it is in (see the catalogs from toolsmith-repo path --project <dir>)."
    git --literal-pathspecs -C "$REPO" ls-files --error-unmatch -- "$src_rel" >/dev/null 2>&1 ||
        die 2 "$src is not committed yet, so it cannot be moved. Install it first (stage and install), then move it."
    [ ! -e "$dst" ] && [ ! -L "$dst" ] ||
        die 9 "$dst already exists, so $name cannot be moved there. Rename or remove one of the two tools, then move again."

    paths=("$src_rel" "$dst_rel" "$(scope_prefix "$from_dir")CATALOG.md" "$(scope_prefix "$to_dir")CATALOG.md")
    note_new_dirs "$to_dir/bin" "$to_dir" "$REPO/projects"
    if [ "$to" = project ]; then
        paths+=("$(scope_prefix "$to_dir")PROJECT")
        snapshot_writes "move of $name" "$src" "$dst" "$from_dir/CATALOG.md" "$to_dir/CATALOG.md" "$to_dir/PROJECT"
    else
        snapshot_writes "move of $name" "$src" "$dst" "$from_dir/CATALOG.md" "$to_dir/CATALOG.md"
    fi
    mkdir -p -- "$to_dir/bin" ||
        die 2 "could not create $to_dir/bin. Check that $REPO is writable."
    # A plain mv rather than git mv: commit_paths stages both sides with
    # add -A, which fails on a path git mv has already removed from the index.
    mv -- "$src" "$dst" ||
        die 2 "could not move $src to $dst, so the move was rolled back. Check that both directories are writable, then move again."
    [ "$to" = global ] || write_project_file
    write_catalog "$from_dir"
    write_catalog "$to_dir"
    adopt_uncommitted "$from_dir" "$src_rel"
    adopt_uncommitted "$to_dir" "$dst_rel"

    commit_paths move "move again" "$message" "${paths[@]}"
    printf '%s' "$NOTES"
    printf 'catalog=%s\n' "$(catalog_line "$dst" "$(header_purpose "$dst")")"
    printf 'commit=%s\n' "$(git -C "$REPO" rev-parse HEAD)"
    printf '%s' "$adopted"
}

# Global paths are printed before the project is resolved, so a caller
# whose --project dir is not in a git repo still gets them before exit 8.
cmd_locate() {
    parse_scope_args locate "$@"
    local repo
    repo=$(locate_repo) || exit $?
    print_paths "$repo"
    print_project_paths "$PROJECT_ARG"
}

main() {
    [ "$#" -gt 0 ] || { usage >&2; exit 1; }
    local subcommand=$1
    shift
    case $subcommand in
        -h|--help|help) usage ;;
        path) cmd_path "$@" ;;
        locate) cmd_locate "$@" ;;
        catalog) cmd_catalog "$@" ;;
        stage) cmd_stage "$@" ;;
        install) cmd_install "$@" ;;
        move) cmd_move "$@" ;;
        *) usage_error "unknown subcommand: $subcommand" ;;
    esac
}

main "$@"
